{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "typeRoots": [
      "./node_modules/@types",
      "/Users/stanley/projects/Maren/node_modules/@types",
      "/Users/stanley/projects/Maren/backend/node_modules/@types"
    ],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/index.ts",
    "src/types.ts",
    "src/crypto/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "src/server/**/*",
    "src/client/**/*"
  ]
}
